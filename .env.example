# ============================================================
# Multi-Agent Banking Assistant — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to version control.

# ------------------------------------------------------------
# LLM Provider Configuration
# ------------------------------------------------------------
# Set LLM_PROVIDER to one of: "gemini", "openai", "mock"
# Use "mock" for fully deterministic mode without any API key.
LLM_PROVIDER=mock

# Google Gemini API Key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API Key (alternative provider)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------
# Application Settings
# ------------------------------------------------------------
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# ------------------------------------------------------------
# FastAPI Backend Settings
# ------------------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# ------------------------------------------------------------
# Database Settings
# ------------------------------------------------------------
DATABASE_URL=sqlite:///./data/banking.db

# ------------------------------------------------------------
# Security (for demo purposes only — not production)
# ------------------------------------------------------------
SECRET_KEY=change-this-in-production-use-long-random-string

# ------------------------------------------------------------
# LLM Behaviour Settings
# ------------------------------------------------------------
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
