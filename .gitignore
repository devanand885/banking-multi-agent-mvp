# ============================================================
# Multi-Agent Banking Assistant — .gitignore
# ============================================================

# Environment & secrets
.env
*.env

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Virtual environments
venv/
.venv/
env/
.env/
ENV/

# IDEs
.vscode/
.idea/
*.swp
*.swo

# Database files (generated — do not commit)
*.db
*.sqlite
*.sqlite3
data/*.db
data/*.db-journal
data/*.db-shm
data/*.db-wal

# Streamlit
.streamlit/secrets.toml

# Logs
*.log
logs/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/

# OS
.DS_Store
Thumbs.db
